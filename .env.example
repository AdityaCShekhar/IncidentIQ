# Synthetic local development only. Compose also works with these defaults without this file.
POSTGRES_DB=incidentiq
POSTGRES_USER=incidentiq
POSTGRES_PASSWORD=incidentiq_local_only
POSTGRES_PORT=5432
APP_PORT=8000
# Used by Python commands running on the host. Compose overrides this to db.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
LOG_LEVEL=INFO
# Host API development can point this at a local OTLP JSON snapshot directory.
TELEMETRY_DIRECTORY=/telemetry

# Host ports for the simulator and telemetry views.
SIMULATOR_PORT=8001
OTLP_PORT=4318
COLLECTOR_HEALTH_PORT=13133
JAEGER_PORT=16686
PROMETHEUS_PORT=9090
